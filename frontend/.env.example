# Nitro connects to the local Trino host port. In Docker, use http://trino:8080.
NUXT_TRINO_URL=http://127.0.0.1:7006
NUXT_TRINO_USER=admin
# Production listener (npm run start)
HOST=127.0.0.1
PORT=7007

# RFN railway layer (server-only; use your infra/lakehouse/.env credentials)
NUXT_MINIO_ENDPOINT=http://127.0.0.1:7004
NUXT_MINIO_BUCKET=railway
NUXT_MINIO_ACCESS_KEY=
NUXT_MINIO_SECRET_KEY=
